{
  "$schema": "https://app.kilo.ai/config.json",
  // Rules: each AGENTS.md index plus one file per rule. Kilo does not follow the @
  // imports in AGENTS.md, so the globs load the rule files themselves. They do not
  // recurse: the agent folders (claude/, cline/, kilo/) stay unloaded.
  "instructions": [
    "AGENTS.md",
    "local/AGENTS.md", "local/rules/*.md",
    "maya/AGENTS.md", "maya/rules/*.md"
  ],
  // Mandatory browser tool (rule browser-automation).
  // Kilo starts the server in the project folder, so the relative path is correct.
  "mcp": {
    "browser-automation-x-mcp": {
      "type": "local",
      "command": ["./maya/tools/browser-automation-x-mcp/run.sh", "--config-dir", "local/configs/browser-automation-x-mcp"],
      "enabled": true,
      // Render mode of the browser.
      "environment": { "RENDER_MODE": "DEFAULT" },
      // The first start can take long.
      "timeout": 60000
    }
  },
  "permission": {
    "browser-automation-x-mcp_*": "allow",
    // Close the browser tool, its config and .mcp.json to the agent. The last matching rule wins.
    "read": { "*": "allow", "maya/tools/browser-automation-x-mcp/**": "deny", "local/configs/browser-automation-x-mcp/**": "deny", ".mcp.json": "deny" },
    "edit": { "*": "allow", "maya/tools/browser-automation-x-mcp/**": "deny", "local/configs/browser-automation-x-mcp/**": "deny", ".mcp.json": "deny" },
    "glob": { "*": "allow", "maya/tools/browser-automation-x-mcp/**": "deny", "local/configs/browser-automation-x-mcp/**": "deny" },
    "grep": { "*": "allow", "maya/tools/browser-automation-x-mcp/**": "deny", "local/configs/browser-automation-x-mcp/**": "deny" },
    "list": { "*": "allow", "maya/tools/browser-automation-x-mcp/**": "deny", "local/configs/browser-automation-x-mcp/**": "deny" },
    "bash": { "*": "allow", "*tools/browser-automation-x-mcp*": "deny", "*configs/browser-automation-x-mcp*": "deny", "*.mcp.json*": "deny" }
  }
}
