#!/bin/sh
# Stop a commit of an edit file of the vault tool, of a private key and of the access log.
# Uses only sh. The check uses the file name only.

git diff --cached --name-only --diff-filter=ACMR | {
    status=0
    while IFS= read -r path; do
        case "${path##*/}" in
            entry-*.json)
                echo "commit blocked - $path: edit file of the vault tool; run sync" >&2
                status=1 ;;
            clone.*.key | access.log | master.key)
                echo "commit blocked - $path: private key or access log" >&2
                status=1 ;;
        esac
    done
    exit "$status"
}
